            && itemOk(d.instructions, 42, 5000)
            && itemOk(d.instructions, 43, 5000)
            && itemOk(d.instructions, 44, 5000)
            && itemOk(d.instructions, 45, 5000)
            && itemOk(d.instructions, 46, 5000)
            && itemOk(d.instructions, 47, 5000)
            && itemOk(d.instructions, 48, 5000)
            && itemOk(d.instructions, 49, 5000)
            && itemOk(d.instructions, 50, 5000)
            && itemOk(d.instructions, 51, 5000)
            && itemOk(d.instructions, 52, 5000)
            && itemOk(d.instructions, 53, 5000)
            && itemOk(d.instructions, 54, 5000)
            && itemOk(d.instructions, 55, 5000)
            && itemOk(d.instructions, 56, 5000)
            && itemOk(d.instructions, 57, 5000)
            && itemOk(d.instructions, 58, 5000)
            && itemOk(d.instructions, 59, 5000)
            && itemOk(d.instructions, 60, 5000)
            && itemOk(d.instructions, 61, 5000)
            && itemOk(d.instructions, 62, 5000)
            && itemOk(d.instructions, 63, 5000)
            && itemOk(d.instructions, 64, 5000)
            && itemOk(d.instructions, 65, 5000)
            && itemOk(d.instructions, 66, 5000)
            && itemOk(d.instructions, 67, 5000)
            && itemOk(d.instructions, 68, 5000)
