            && itemOk(d.tips, 20, 2000)
            && itemOk(d.tips, 21, 2000)
            && itemOk(d.tips, 22, 2000)
            && itemOk(d.tips, 23, 2000)
            && itemOk(d.tips, 24, 2000)
            && itemOk(d.tips, 25, 2000)
            && itemOk(d.tips, 26, 2000)
            && itemOk(d.tips, 27, 2000)
            && itemOk(d.tips, 28, 2000)
            && itemOk(d.tips, 29, 2000)
            && itemOk(d.tips, 30, 2000)
            && itemOk(d.tips, 31, 2000)
            && itemOk(d.tips, 32, 2000)
            && itemOk(d.tips, 33, 2000)
            && itemOk(d.tips, 34, 2000)
            && itemOk(d.tips, 35, 2000)
            && itemOk(d.tips, 36, 2000)
            && itemOk(d.tips, 37, 2000)
            && itemOk(d.tips, 38, 2000)
            && itemOk(d.tips, 39, 2000)
            && itemOk(d.tips, 40, 2000)
            && itemOk(d.tips, 41, 2000)
            && itemOk(d.tips, 42, 2000)
            && itemOk(d.tips, 43, 2000)
            && itemOk(d.tips, 44, 2000)
            && itemOk(d.tips, 45, 2000)
            && itemOk(d.tips, 46, 2000)
            && itemOk(d.tips, 47, 2000)
            && itemOk(d.tips, 48, 2000)
            && itemOk(d.tips, 49, 2000)
          ))
          && (!('preparationTime' in d) || (d.preparationTime is string && d.preparationTime.size() <= 50))
          && (!('cookingTime' in d) || (d.cookingTime is string && d.cookingTime.size() <= 50))
          && (!('servings' in d) || (d.servings is int && d.servings > 0 && d.servings <= 100))
          && (!('difficulty' in d) || (d.difficulty is string && d.difficulty.size() <= 40))
          && (!('cuisine' in d) || (d.cuisine is string && d.cuisine.size() <= 80))
          && (!('calories' in d) || d.calories == null || (d.calories is number && d.calories >= 0 && d.calories <= 20000))
          && (!('macros' in d) || d.macros == null || (
            d.macros is map
            && d.macros.keys().hasOnly(['protein', 'carbs', 'fat'])
          ));
      }

      allow read: if isOwnerByUserIdField();

      allow create: if isSignedIn() && validRecipeShape();

      allow update: if isOwnerByUserIdField()
        && validRecipeShape()
        && request.resource.data.userId == resource.data.userId;

      allow delete: if isOwnerByUserIdField();
    }

    /**
     * Collection: userProfiles
     * Document id is the UID. Client writes omit id (doc id is the uid).
     */
    match /userProfiles/{userId} {
      function profileKeys() {
        return [
          'dietary', 'allergies', 'dislikedIngredients',
          'cookingExperience', 'servingSize', 'preferredCuisines', 'updatedAt'
        ];
      }

      function validProfileShape() {
        let d = request.resource.data;
        return d.keys().hasOnly(profileKeys())
          && d.dietary is list
            && d.dietary.size() <= 30
            && itemOk(d.dietary, 0, 200)
            && itemOk(d.dietary, 1, 200)
            && itemOk(d.dietary, 2, 200)
            && itemOk(d.dietary, 3, 200)
            && itemOk(d.dietary, 4, 200)
            && itemOk(d.dietary, 5, 200)
            && itemOk(d.dietary, 6, 200)
