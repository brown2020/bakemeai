rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerByUserIdField() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // value[index] is only evaluated when the list is longer than index.
    // Keep item caps in sync with src/lib/schemas/generation-profile.ts.
    function itemOk(value, index, maxItemLength) {
      return value.size() <= index
        || (value[index] is string && value[index].size() <= maxItemLength);
    }

    // Deny everything by default.
    match /{document=**} {
      allow read, write: if false;
    }

    /**
     * Collection: recipes
     * Ownership: resource.data.userId === request.auth.uid
     * Creates/updates must only include known fields with basic type/size limits.
     */
    match /recipes/{recipeId} {
      function recipeKeys() {
        return [
          'userId', 'title', 'content', 'createdAt',
          'ingredients', 'instructions', 'tips',
          'preparationTime', 'cookingTime', 'servings',
          'difficulty', 'calories', 'macros', 'cuisine'
        ];
      }

      function validRecipeShape() {
        let d = request.resource.data;
        return d.keys().hasOnly(recipeKeys())
          && d.userId is string
          && d.userId == request.auth.uid
          && d.title is string
          && d.title.size() > 0
          && d.title.size() <= 200
          && d.content is string
          && d.content.size() > 0
          && d.content.size() <= 50000
          && d.createdAt is timestamp
          && (!('ingredients' in d) || (
            d.ingredients is list
            && d.ingredients.size() <= 100
            && itemOk(d.ingredients, 0, 1000)
            && itemOk(d.ingredients, 1, 1000)
            && itemOk(d.ingredients, 2, 1000)
            && itemOk(d.ingredients, 3, 1000)
            && itemOk(d.ingredients, 4, 1000)
            && itemOk(d.ingredients, 5, 1000)
            && itemOk(d.ingredients, 6, 1000)
            && itemOk(d.ingredients, 7, 1000)
            && itemOk(d.ingredients, 8, 1000)
            && itemOk(d.ingredients, 9, 1000)
            && itemOk(d.ingredients, 10, 1000)
            && itemOk(d.ingredients, 11, 1000)
            && itemOk(d.ingredients, 12, 1000)
            && itemOk(d.ingredients, 13, 1000)
            && itemOk(d.ingredients, 14, 1000)
            && itemOk(d.ingredients, 15, 1000)
            && itemOk(d.ingredients, 16, 1000)
            && itemOk(d.ingredients, 17, 1000)
            && itemOk(d.ingredients, 18, 1000)
            && itemOk(d.ingredients, 19, 1000)
            && itemOk(d.ingredients, 20, 1000)
            && itemOk(d.ingredients, 21, 1000)
            && itemOk(d.ingredients, 22, 1000)
            && itemOk(d.ingredients, 23, 1000)
            && itemOk(d.ingredients, 24, 1000)
            && itemOk(d.ingredients, 25, 1000)
            && itemOk(d.ingredients, 26, 1000)
            && itemOk(d.ingredients, 27, 1000)
            && itemOk(d.ingredients, 28, 1000)
            && itemOk(d.ingredients, 29, 1000)
            && itemOk(d.ingredients, 30, 1000)
            && itemOk(d.ingredients, 31, 1000)
            && itemOk(d.ingredients, 32, 1000)
            && itemOk(d.ingredients, 33, 1000)
            && itemOk(d.ingredients, 34, 1000)
            && itemOk(d.ingredients, 35, 1000)
            && itemOk(d.ingredients, 36, 1000)
            && itemOk(d.ingredients, 37, 1000)
            && itemOk(d.ingredients, 38, 1000)
            && itemOk(d.ingredients, 39, 1000)
            && itemOk(d.ingredients, 40, 1000)
            && itemOk(d.ingredients, 41, 1000)
            && itemOk(d.ingredients, 42, 1000)
            && itemOk(d.ingredients, 43, 1000)
            && itemOk(d.ingredients, 44, 1000)
            && itemOk(d.ingredients, 45, 1000)
            && itemOk(d.ingredients, 46, 1000)
            && itemOk(d.ingredients, 47, 1000)
