            && itemOk(d.ingredients, 98, 1000)
            && itemOk(d.ingredients, 99, 1000)
          ))
          && (!('instructions' in d) || (
            d.instructions is list
            && d.instructions.size() <= 100
            && itemOk(d.instructions, 0, 5000)
            && itemOk(d.instructions, 1, 5000)
            && itemOk(d.instructions, 2, 5000)
            && itemOk(d.instructions, 3, 5000)
            && itemOk(d.instructions, 4, 5000)
