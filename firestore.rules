            && itemOk(d.dietary, 28, 200)
            && itemOk(d.dietary, 29, 200)
          && d.allergies is list
            && d.allergies.size() <= 50
            && itemOk(d.allergies, 0, 200)
            && itemOk(d.allergies, 1, 200)
            && itemOk(d.allergies, 2, 200)
            && itemOk(d.allergies, 3, 200)
