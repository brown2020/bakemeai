rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerByUserIdField() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Firestore rules cannot loop. Checking every list index exceeds the
    // rules compiler ("Expression is too complex to evaluate safely").
    // List length and container type stay here. Per-item string length is
    // enforced by completeRecipeStructureSchema and generationProfileSchema
    // before the app writes.
    function isBoundedList(value, maxItems) {
      return value is list && value.size() <= maxItems;
    }

    // Deny everything by default.
    match /{document=**} {
      allow read, write: if false;
    }

    /**
     * Collection: recipes
     * Ownership: resource.data.userId === request.auth.uid
     * Creates/updates must only include known fields with basic type/size limits.
     */
    match /recipes/{recipeId} {
      function recipeKeys() {
        return [
          'userId', 'title', 'content', 'createdAt',
          'ingredients', 'instructions', 'tips',
          'preparationTime', 'cookingTime', 'servings',
          'difficulty', 'calories', 'macros', 'cuisine'
        ];
      }

      function validRecipeShape() {
        let d = request.resource.data;
        return d.keys().hasOnly(recipeKeys())
          && d.userId is string
          && d.userId == request.auth.uid
          && d.title is string
          && d.title.size() > 0
          && d.title.size() <= 200
          && d.content is string
          && d.content.size() > 0
          && d.content.size() <= 50000
          && d.createdAt is timestamp
          && (!('ingredients' in d) || isBoundedList(d.ingredients, 100))
          && (!('instructions' in d) || isBoundedList(d.instructions, 100))
          && (!('tips' in d) || isBoundedList(d.tips, 50))
          && (!('preparationTime' in d) || (d.preparationTime is string && d.preparationTime.size() <= 50))
          && (!('cookingTime' in d) || (d.cookingTime is string && d.cookingTime.size() <= 50))
          && (!('servings' in d) || (d.servings is int && d.servings > 0 && d.servings <= 100))
          && (!('difficulty' in d) || (d.difficulty is string && d.difficulty.size() <= 40))
          && (!('cuisine' in d) || (d.cuisine is string && d.cuisine.size() <= 80))
          && (!('calories' in d) || d.calories == null || (d.calories is number && d.calories >= 0 && d.calories <= 20000))
          && (!('macros' in d) || d.macros == null || (
            d.macros is map
            && d.macros.keys().hasOnly(['protein', 'carbs', 'fat'])
          ));
      }

      allow read: if isOwnerByUserIdField();

      allow create: if isSignedIn() && validRecipeShape();

      allow update: if isOwnerByUserIdField()
        && validRecipeShape()
        && request.resource.data.userId == resource.data.userId;

      allow delete: if isOwnerByUserIdField();
    }

    /**
     * Collection: userProfiles
     * Document id is the UID. Client writes omit id (doc id is the uid).
     */
    match /userProfiles/{userId} {
      function profileKeys() {
        return [
          'dietary', 'allergies', 'dislikedIngredients',
          'cookingExperience', 'servingSize', 'preferredCuisines', 'updatedAt'
        ];
      }

      function validProfileShape() {
        let d = request.resource.data;
        return d.keys().hasOnly(profileKeys())
          && isBoundedList(d.dietary, 30)
          && isBoundedList(d.allergies, 50)
          && isBoundedList(d.dislikedIngredients, 50)
          && isBoundedList(d.preferredCuisines, 30)
          && d.cookingExperience in ['beginner', 'intermediate', 'advanced']
          && d.servingSize is int
          && d.servingSize >= 1
          && d.servingSize <= 12
          && d.updatedAt is timestamp;
      }

      allow read: if isSignedIn() && request.auth.uid == userId;

      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && validProfileShape();

      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Collection: generationRateLimits
     * Document id is the UID. Written by the signed-in user during generation.
     * Caps must stay in sync with GENERATION_QUOTA in
     * src/lib/utils/generation-quota.ts (8 requests, 60000 ms window, 10000 ms skew).
     */
    match /generationRateLimits/{userId} {
      function validQuotaShape(data) {
        return data.keys().hasOnly(['count', 'windowStart'])
          && data.count is int
          && data.windowStart is int;
      }

      function windowStartNearRequestTime(millis) {
        return millis >= request.time.toMillis() - 10000
          && millis <= request.time.toMillis() + 10000;
      }

      allow read: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && validQuotaShape(request.resource.data)
        && request.resource.data.count == 1
        && windowStartNearRequestTime(request.resource.data.windowStart);

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && validQuotaShape(resource.data)
        && validQuotaShape(request.resource.data)
        && (
          (
            request.time.toMillis() - resource.data.windowStart >= 60000
            && request.resource.data.count == 1
            && windowStartNearRequestTime(request.resource.data.windowStart)
          )
          || (
            request.resource.data.windowStart == resource.data.windowStart
            && request.resource.data.count == resource.data.count + 1
            && resource.data.count < 8
            && request.time.toMillis() - resource.data.windowStart < 60000
          )
        );

      allow delete: if false;
    }
  }
}
