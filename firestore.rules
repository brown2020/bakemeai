            && itemOk(d.instructions, 70, 5000)
            && itemOk(d.instructions, 71, 5000)
            && itemOk(d.instructions, 72, 5000)
            && itemOk(d.instructions, 73, 5000)
            && itemOk(d.instructions, 74, 5000)
            && itemOk(d.instructions, 75, 5000)
            && itemOk(d.instructions, 76, 5000)
            && itemOk(d.instructions, 77, 5000)
            && itemOk(d.instructions, 78, 5000)
            && itemOk(d.instructions, 79, 5000)
            && itemOk(d.instructions, 80, 5000)
            && itemOk(d.instructions, 81, 5000)
            && itemOk(d.instructions, 82, 5000)
            && itemOk(d.instructions, 83, 5000)
            && itemOk(d.instructions, 84, 5000)
            && itemOk(d.instructions, 85, 5000)
            && itemOk(d.instructions, 86, 5000)
            && itemOk(d.instructions, 87, 5000)
