            && itemOk(d.instructions, 98, 5000)
            && itemOk(d.instructions, 99, 5000)
          ))
          && (!('tips' in d) || (
            d.tips is list
            && d.tips.size() <= 50
            && itemOk(d.tips, 0, 2000)
            && itemOk(d.tips, 1, 2000)
            && itemOk(d.tips, 2, 2000)
            && itemOk(d.tips, 3, 2000)
            && itemOk(d.tips, 4, 2000)
            && itemOk(d.tips, 5, 2000)
            && itemOk(d.tips, 6, 2000)
            && itemOk(d.tips, 7, 2000)
